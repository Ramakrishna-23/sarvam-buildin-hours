LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
PORT=8787
# Must match the Vite dev server's actual origin — only this origin can read
# a token from this server. Update if Vite picks a different port (e.g.
# 5173 already in use).
CLIENT_ORIGIN=http://localhost:5173
